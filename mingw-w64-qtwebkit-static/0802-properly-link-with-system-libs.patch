 endif ()
 
+find_package(PkgConfig REQUIRED)
+
+macro(ensure_static_pkgconfig_target pkg_name)
+    if (TARGET PkgConfig::${pkg_name} AND NOT TARGET PkgConfig::${pkg_name}_STATIC)
+        add_library(PkgConfig::${pkg_name}_STATIC INTERFACE IMPORTED)
+        get_target_property(_include_dirs PkgConfig::${pkg_name} INTERFACE_INCLUDE_DIRECTORIES)
+        get_target_property(_compile_defs PkgConfig::${pkg_name} INTERFACE_COMPILE_DEFINITIONS)
+        get_target_property(_link_libs PkgConfig::${pkg_name} INTERFACE_LINK_LIBRARIES)
+        
+        if (_include_dirs)
+            set_target_properties(PkgConfig::${pkg_name}_STATIC PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_include_dirs}")
+        endif()
+        if (_compile_defs)
+            set_target_properties(PkgConfig::${pkg_name}_STATIC PROPERTIES INTERFACE_COMPILE_DEFINITIONS "${_compile_defs}")
+        endif()
+        if (_link_libs)
+            set_target_properties(PkgConfig::${pkg_name}_STATIC PROPERTIES INTERFACE_LINK_LIBRARIES "${_link_libs}")
+        endif()
+    endif()
+endmacro()
+
