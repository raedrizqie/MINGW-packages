diff --git a/providers/firebird/meson.build b/providers/firebird/meson.build
new file mode 100644
index 0000000..c6cf962
--- /dev/null
+++ b/providers/firebird/meson.build
@@ -0,0 +1,165 @@
+inc_libgda_firebirdh = include_directories ('.')
+inc_libgda_firebirdh_dep = declare_dependency (include_directories : inc_libgda_firebirdh)
+
+sh = find_program('sh')
+
+firebird_parser = custom_target('firebird-parser',
+	command: [
+		lemon_exe,
+		'-q',
+		'-o@OUTDIR@',
+		'-T@INPUT0@',
+		'@INPUT1@'
+		],
+	input: [lemon_templatef, 'parser.y'],
+	output: ['parser.c', 'parser.h']
+	)
+
+firebird_parserc = firebird_parser[0]
+firebird_parserh = firebird_parser[1]
+
+firebird_gen_def = executable('firebird_gen_def',
+	'gen_def.c',
+	native: true,
+	c_args: [
+		'-DIMPOSED_HEADER="' + token_types.full_path() + '"'
+		],
+	install: false
+	)
+
+firebird_token_typesh = custom_target('firebird-token-typesh',
+	command: [
+		sh, '-c', 'cd "$1" && exec "$2"', 'sh',
+		meson.current_build_dir(),
+		firebird_gen_def.full_path()
+		],
+	output: 'firebird_token_types.h',
+	depends: [
+		firebird_gen_def,
+		firebird_parserh,
+		token_types
+		],
+	capture: true
+	)
+
+libgda_firebird_sources = files([
+	'gda-firebird-blob-op.c',
+	'gda-firebird-blob-op.h',
+	'gda-firebird-ddl.c',
+	'gda-firebird-ddl.h',
+	'gda-firebird-meta.c',
+	'gda-firebird-meta.h',
+	'gda-firebird-parser.c',
+	'gda-firebird-parser.h',
+	'gda-firebird-provider.c',
+	'gda-firebird-provider.h',
+	'gda-firebird-pstmt.c',
+	'gda-firebird-pstmt.h',
+	'gda-firebird-recordset.c',
+	'gda-firebird-recordset.h',
+	'gda-firebird-util.c',
+	'gda-firebird-util.h',
+	'gda-firebird.h'
+	])
+
+libgda_firebird_sources += firebird_parserc
+libgda_firebird_sources += firebird_parserh
+libgda_firebird_sources += firebird_token_typesh
+
+firebird_xml_fnames = [
+	'firebird_specs_create_table',
+	'firebird_specs_dsn',
+	'firebird_specs_dsn_emb'
+	]
+
+firebird_xml_fnamesext = []
+foreach fn : firebird_xml_fnames
+	firebird_xml_fnamesext += [fn+'.xml.in']
+endforeach
+
+firebird_xml_inf = files(firebird_xml_fnamesext)
+
+firebird_xml_res = []
+foreach xt : firebird_xml_fnames
+	i18n.merge_file(
+		input: xt+'.xml.in',
+		output: xt+'.xml.in.h',
+		type: 'xml',
+		po_dir: join_paths(meson.project_build_root(),'po')
+		)
+	firebird_xml_res += custom_target(xt+'.raw.xml',
+		command: [raw_spec,
+			'-o', meson.current_build_dir(),
+			'@INPUT@'
+			],
+		input: xt+'.xml.in',
+		output: xt+'.raw.xml',
+		)
+endforeach
+
+firebird_resourcesc = custom_target('firebird_resourcesc',
+	command: [compile_resources,
+		'--sourcedir='+meson.current_build_dir(),
+		'--generate-source',
+		'--target', '@OUTPUT@',
+		'--internal',
+		'@INPUT@'
+		],
+	input: 'firebird.gresource.xml',
+	output: 'firebird_resource.c',
+	depends: firebird_xml_res,
+	install: false
+	)
+
+firebird_resourcesh = custom_target('firebird_resourcesh',
+	command: [compile_resources,
+		'--sourcedir='+meson.current_build_dir(),
+		'--generate-header',
+		'--target', '@OUTPUT@',
+		'--internal',
+		'@INPUT@'
+		],
+	input: 'firebird.gresource.xml',
+	output: 'firebird_resource.h',
+	depends: firebird_xml_res,
+	install: false
+	)
+firebird_resources = [
+	firebird_resourcesc,
+	firebird_resourcesh
+	]
+
+libgda_firebird_sources += firebird_resources
+
+firebird_cargs = [
+	'-include',
+	join_paths(gda_top_build, 'config.h')
+	]
+
+firebird_cargs += c_args
+
+libgda_firebird_providerpc = configure_file(
+			input:  'libgda-firebird-'+project_api_version+'.pc.in',
+			output: 'libgda-firebird-'+project_api_version+'.pc',
+			configuration : conf,
+			install_dir: join_paths(get_option('libdir'),'pkgconfig')
+			)
+
+if firebird_dep.found()
+	libgda_firebird_client_provider = library ('gda-firebird-client-'+project_api_version,
+		libgda_firebird_sources,
+		files('libmain-client.c'),
+		dependencies: [
+			libgda_dep,
+			firebird_dep,
+			token_types_dep,
+			inc_libgdah_dep,
+			inc_libgda_firebirdh_dep
+			],
+		include_directories: inc_libsql_parserh,
+		c_args: firebird_cargs,
+		link_with: libgda,
+		install: true,
+		install_dir: join_paths(get_option('libdir'), project_package, 'providers')
+		)
+endif
