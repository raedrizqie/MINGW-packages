# Maintainer:  Matheus Catarino <matheus-catarino@hotmail.com>

_realname=zig
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.17.1
pkgrel=1
pkgdesc='A general-purpose programming language and toolchain for maintaining robust, optimal, and reusable software (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://ziglang.org'
msys2_repository_url='https://codeberg.org/ziglang/zig'
msys2_documentation_url='https://codeberg.org/ziglang/zig?tab=readme-ov-file#readme'
msys2_references=(
  'archlinux: zig'
  'gentoo: dev-lang/zig'
)
license=('spdx:MIT')
depends=(
  #"${MINGW_PACKAGE_PREFIX}-clang-libs"
  "${MINGW_PACKAGE_PREFIX}-llvm-libs"
  "${MINGW_PACKAGE_PREFIX}-zstd"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-clang"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-libc++"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "unzip"
)
source=("https://ziglang.org/download/${pkgver}/${_realname}-${pkgver}.tar.xz"
        "https://ziglang.org/download/${pkgver}/${_realname}-${CARCH}-windows-${pkgver}.zip")
noextract=("${_realname}-${CARCH}-windows-${pkgver}.zip")
sha256sums=('SKIP'
            'SKIP')

prepare() {
  unzip ${_realname}-${CARCH}-windows-${pkgver}.zip
  mv ${_realname}-${CARCH}-windows-${pkgver} zig
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  local _cxx="x86_64"
  if [[ ${MSYSTEM} == CLANGARM64 ]]; then
    _cxx="aarch64"
  fi

  export CC="${srcdir}/zig/zig.exe cc"
  export CXX="${srcdir}/zig/zig.exe c++"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  cmake -Wno-author \
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
    -DCMAKE_C_COMPILER=${CC} \
    -DCMAKE_CXX_COMPILER=${CXX} \
    -DCMAKE_AR="zig/zig.exe" \
    -DZIG_HOST_TARGET_TRIPLE=${CARCH}-windows-gnu \
    -DZIG_TARGET_TRIPLE=${CARCH}-windows-gnu \
    -DZIG_AR_WORKAROUND=ON \
    -DZIG_SHARED_LLVM=ON \
    -DZIG_SYSTEM_LIBCXX=${CARCH} \
    -DZIG_TARGET_MCPU=baseline \
    -DZIG_USE_LLVM_CONFIG=ON \
    "${_extra_config[@]}" \
    -S ${_realname}-${pkgver} \
    -B build-${MSYSTEM}

  cmake --build build-${MSYSTEM}
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}

  install -Dm644 "${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}
